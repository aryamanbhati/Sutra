# Server
PORT=8080
NODE_ENV=development
JWT_SECRET=replace-me-with-long-random-string
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/sutra?retryWrites=true&w=majority

# Upstash Redis (REST)
UPSTASH_REDIS_REST_URL=https://<region>-<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Narrative generation — Groq (OpenAI-compatible, open models). Optional: without it,
# the server falls back to a deterministic grounded template.
GROQ_API_KEY=gsk_replace-me
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Client (Vite)
VITE_API_URL=http://localhost:8080
