# Server
PORT=8080
NODE_ENV=development
JWT_SECRET=replace-me-with-long-random-string
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/sutra?retryWrites=true&w=majority

# Upstash Redis (REST)
UPSTASH_REDIS_REST_URL=https://<region>-<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Anthropic (Phase 3)
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-sonnet-4-6

# Client (Vite)
VITE_API_URL=http://localhost:8080
